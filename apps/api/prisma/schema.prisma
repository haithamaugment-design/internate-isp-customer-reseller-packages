generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrganizationType {
  ISP
  RESELLER
}

enum UserRole {
  PLATFORM_OWNER
  ISP_ADMIN
  RESELLER
  CUSTOMER
  SUPPORT_AGENT
}

enum RouterStatus {
  ACTIVE
  OFFLINE
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum VoucherStatus {
  UNUSED
  USED
  EXPIRED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketSource {
  CUSTOMER
  RESELLER
  SUPPORT
  SYSTEM
}

enum RouterAdapterCommandStatus {
  PENDING
  APPLIED
  FAILED
}

enum RouterAdapterReconciliationStatus {
  PENDING
  APPLIED
  FAILED
}

model Organization {
  id          String           @id @default(uuid()) @map("id")
  name        String
  type        OrganizationType
  parentOrgId String?
  parentOrg   Organization?    @relation("OrgHierarchy", fields: [parentOrgId], references: [id])
  children    Organization[]   @relation("OrgHierarchy")
  status      String           @default("ACTIVE") @map("status") // ACTIVE | SUSPENDED | PENDING_APPROVAL
  branding    Json?            // white-label: { brandName, primaryColor, logoUrl, welcomeMessage, footerText }
  subscriptionPlan   String   @default("free") @map("subscription_plan") // free | growth | enterprise
  subscriptionExpires DateTime? @map("subscription_expires")
  voucherCommissionPct Int    @default(5) @map("voucher_commission_pct") // 5% for free, 0% for paid

  users       User[]
  locations   Location[]
  packages    Package[]
  vouchers    Voucher[]
  customers   Customer[]
  tickets     Ticket[]

  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  createdByUserId String?  @map("created_by_user_id")
  updatedByUserId String?  @map("updated_by_user_id")
  deletedAt     DateTime?  @map("deleted_at")

  @@index([parentOrgId])
  @@index([type, status])
  @@map("organizations")
}

model User {
  id             String       @id @default(uuid()) @map("id")
  name           String
  email          String       @unique
  passwordHash   String       @map("password_hash")
  role           UserRole
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  customerId     String?      @unique @map("customer_id")
  customer       Customer?    @relation(fields: [customerId], references: [id])
  assignedTickets  Ticket[] @relation("TicketAssignee")
  requestedTickets Ticket[] @relation("TicketRequester")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")

  @@index([organizationId])
  @@index([role])
  @@map("users")
}

model Location {
  id             String       @id @default(uuid()) @map("id")
  name           String
  address        String?
  latitude       Float?       @map("latitude")
  longitude      Float?       @map("longitude")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  routers        Router[]
  vouchers       Voucher[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")

  @@index([organizationId])
  @@map("locations")
}

model Router {
  id           String        @id @default(uuid()) @map("id")
  name         String
  macAddress   String        @unique
  adapterType  String        @default("mikrotik")
  status       RouterStatus  @default(ACTIVE)
  locationId   String
  location     Location      @relation(fields: [locationId], references: [id])
  customers    Customer[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")

  @@index([locationId])
  @@map("router_devices")
}

model Package {
  id             String       @id @default(uuid()) @map("id")
  name           String
  speedMbps      Int
  dataCapGb      Int?         // null = unlimited
  priceCents     Int
  currency       String       @default("TZS")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  subscriptions  Subscription[]
  bandwidthRules BandwidthRule[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")

  @@index([organizationId])
  @@map("packages")
}

// Bandwidth rule templates attached to a package (stored only — no live enforcement in MVP)
model BandwidthRule {
  id             String  @id @default(uuid()) @map("id")
  name           String
  downloadMbps   Int
  uploadMbps     Int
  priority       Int     @default(0)
  packageId      String
  package        Package @relation(fields: [packageId], references: [id])

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")

  @@index([packageId])
  @@map("bandwidth_rules")
}

model Customer {
  id           String          @id @default(uuid()) @map("id")
  name         String
  phone        String
  wifiSsid     String?
  wifiPassword String?
  status       CustomerStatus  @default(ACTIVE)
  routerId     String
  router       Router          @relation(fields: [routerId], references: [id])
  organizationId String
  organization Organization    @relation(fields: [organizationId], references: [id])
  subscription Subscription?
  devices      Device[]
  usageRecords UsageRecord[]
  serviceRequests ServiceRequest[]
  notifications Notification[]
  user         User?

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")
  deletedAt     DateTime? @map("deleted_at")

  @@index([routerId])
  @@index([organizationId, status])
  @@map("customers")
}

model Subscription {
  id           String   @id @default(uuid()) @map("id")
  customerId   String   @unique
  customer     Customer @relation(fields: [customerId], references: [id])
  packageId    String
  package      Package  @relation(fields: [packageId], references: [id])
  startedAt    DateTime @default(now()) @map("started_at")
  renewsAt     DateTime? @map("renews_at")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")

  @@index([packageId])
  @@map("subscriptions")
}

model Voucher {
  id             String        @id @default(uuid()) @map("id")
  code           String        @unique
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  locationId     String?       // optional: location-specific voucher batch
  location       Location?     @relation(fields: [locationId], references: [id])
  dataGb         Int?
  durationHours  Int?
  status         VoucherStatus @default(UNUSED)
  usedByCustomerId String?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")

  @@index([organizationId, status])
  @@index([locationId])
  @@map("vouchers")
}

model Device {
  id          String    @id @default(uuid()) @map("id")
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  macAddress  String
  deviceName  String?
  lastSeenAt  DateTime? @map("last_seen_at")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")

  @@index([customerId])
  @@map("devices")
}

model AuditLog {
  id           String    @id @default(uuid()) @map("id")
  actorUserId  String?
  action       String
  entityType   String
  entityId     String
  beforeJson   Json?
  afterJson    Json?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

model RouterAdapterCommand {
  id             String                      @id @default(uuid()) @map("id")
  routerId       String                      @map("router_id")
  kind           String
  payload        Json
  status         RouterAdapterCommandStatus  @default(PENDING)
  idempotencyKey String?                     @unique @map("idempotency_key")
  attempts       Int                         @default(0)
  lastError      String?                     @map("last_error")
  executedAt     DateTime?                   @map("executed_at")
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")

  @@index([routerId, status])
  @@map("router_adapter_commands")
}

model RouterAdapterReconciliation {
  id          String                            @id @default(uuid()) @map("id")
  routerId    String                            @unique @map("router_id")
  adapterKind String                            @map("adapter_kind")
  status      RouterAdapterReconciliationStatus @default(PENDING)
  desiredJson Json                              @map("desired_json")
  appliedJson Json                              @map("applied_json")
  createdAt   DateTime                          @default(now()) @map("created_at")
  updatedAt   DateTime                          @updatedAt @map("updated_at")

  @@index([status])
  @@map("router_adapter_reconciliations")
}

model UsageRecord {
  id          String   @id @default(uuid()) @map("id")
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  day         DateTime @map("day")
  bytesUsed   BigInt   @map("bytes_used") @default(0)

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")

  @@index([customerId, day])
  @@map("usage_records")
}

model ServiceRequest {
  id           String   @id @default(uuid()) @map("id")
  type         String   // UPGRADE | SUPPORT
  status       String   @default("OPEN") // OPEN | IN_PROGRESS | CLOSED
  message      String?
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")

  @@index([customerId])
  @@map("service_requests")
}

model Ticket {
  id              String         @id @default(uuid()) @map("id")
  subject         String
  description     String?
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  source          TicketSource   @default(SUPPORT)
  entityType      String?
  entityId        String?
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  assigneeId      String?
  assignee        User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  requesterId     String?
  requester       User?          @relation("TicketRequester", fields: [requesterId], references: [id])
  slaRespondBy    DateTime?      @map("sla_respond_by")
  slaResolveBy    DateTime?      @map("sla_resolve_by")
  firstResponseAt DateTime?      @map("first_response_at")
  resolvedAt      DateTime?      @map("resolved_at")
  closedAt        DateTime?      @map("closed_at")
  comments        TicketComment[]
  notifications   Notification[]

  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  createdByUserId String?  @map("created_by_user_id")
  updatedByUserId String?  @map("updated_by_user_id")
  deletedAt     DateTime?  @map("deleted_at")

  @@index([organizationId, status])
  @@index([assigneeId, status])
  @@index([entityType, entityId])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid()) @map("id")
  ticketId   String   @map("ticket_id")
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String?  @map("author_id")
  authorRole String
  body       String
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

// Customer-facing in-app notifications. Created when an agent replies to a
// customer ticket. Polled by the customer portal to show a "new reply" badge.
model BlogCategory {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  description String?
  parentId    String?
  parent      BlogCategory?   @relation("BlogCategoryTree", fields: [parentId], references: [id])
  children    BlogCategory[]  @relation("BlogCategoryTree")
  posts       BlogPost[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("blog_categories")
}

model BlogPost {
  id             String          @id @default(uuid())
  title          String
  slug           String          @unique
  excerpt        String?
  content        String
  featuredImage  String?
  categoryId     String?
  category       BlogCategory?   @relation(fields: [categoryId], references: [id])
  authorId       String?
  published      Boolean         @default(false)
  publishedAt    DateTime?
  tags           String[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdByUserId String?
  updatedByUserId String?
  productLinks   BlogProductLink[]

  @@map("blog_posts")
}

model ProductCategory {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  description String?
  parentId    String?
  parent      ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("ProductCategoryTree")
  products    Product[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("product_categories")
}

model Product {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  description      String?
  shortDescription String?
  priceCents       Int
  currency         String            @default("TZS")
  images           String[]
  categoryId       String?
  category         ProductCategory?  @relation(fields: [categoryId], references: [id])
  specs            Json?
  stock            Int               @default(0)
  featured         Boolean           @default(false)
  published        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdByUserId  String?
  updatedByUserId  String?
  blogLinks        BlogProductLink[]

  @@map("products")
}

model BlogProductLink {
  id          String    @id @default(uuid())
  blogPostId  String
  blogPost    BlogPost  @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([blogPostId, productId])
  @@map("blog_product_links")
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model BusinessPlan {
  id                    String   @id @default(uuid())
  resellerId            String
  name                  String
  monthlyProfitTarget   Int      @default(0)
  monthlyRevenueTarget  Int      @default(0)
  totalCosts            Int      @default(0)
  costs                 Json     @default("{}")
  locationPlans         Json     @default("[]")
  status                String   @default("DRAFT")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  activatedAt           DateTime? @map("activated_at")
  messages              BusinessPlanMessage[]

  @@index([resellerId])
  @@map("business_plans")
}

model BusinessPlanMessage {
  id        String   @id @default(uuid())
  planId    String   @map("plan_id")
  plan      BusinessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  role      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([planId])
  @@map("business_plan_messages")
}

model Notification {
  id          String    @id @default(uuid()) @map("id")
  customerId  String    @map("customer_id")
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ticketId    String?   @map("ticket_id")
  ticket      Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind        String    // TICKET_REPLY
  title       String
  body        String
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")
  deletedAt       DateTime? @map("deleted_at")

  @@index([customerId, readAt])
  @@index([ticketId])
  @@map("notifications")
}
